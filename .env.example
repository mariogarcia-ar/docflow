# docflow — environment defaults
#
# Copy to `.env` and adjust. Values here are defaults for every invocation;
# a CLI flag always overrides the matching variable.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.
#
# This file covers the first instance: nine flags and the corpus settings.
# Settings for deferred flags are not here — see `cli.md`, *Options*.

# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
# Local extraction model, used by every pipeline that calls one — EpVR and
# ErpVR, including M4-EpVR, whose extractor reads pixels directly. A
# per-invocation --model overrides it, so M4 can point at a vision model
# without changing this.
DOCFLOW_MODEL=ollama:qwen2.5

# The frontier LLM that governs escalation and sets "could not" — see
# components.md. One of: claude | deepseek | openai
DOCFLOW_VALIDATOR=claude

# ─────────────────────────────────────────────────────────────────────────────
# Provider configuration
# ─────────────────────────────────────────────────────────────────────────────
# No CLI flag for these, on purpose: an endpoint and a credential are
# environment facts, not per-invocation decisions. Keeping them here means
# secrets never reach shell history or a process listing.

# Ollama endpoint. Unset uses the provider default.
# DOCFLOW_OLLAMA_HOST=http://127.0.0.1:11434

# Credential for the validator above. Only its provider needs to be set.
# These are secrets — never in a committed file.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────────────────────────────────────
# Output directory. Results, ledgers and intermediates all live here, and a
# folder input mirrors its tree. See "Output directory" in cli.md.
DOCFLOW_OUT=out

# ─────────────────────────────────────────────────────────────────────────────
# Execution
# ─────────────────────────────────────────────────────────────────────────────
# Concurrency for batch runs. Size to the machine, not to the corpus: the
# local model is usually the bottleneck, not the CPU.
DOCFLOW_JOBS=2

# Pipeline used when neither --pipeline nor --extractor is given.
# The thirteen codes are in pipelines.md.
# DOCFLOW_PIPELINE=M1-ErpVR

# Extractor mode when the material is inferred per file: r | p | rp
# DOCFLOW_EXTRACTOR=rp

# ─────────────────────────────────────────────────────────────────────────────
# Corpus settings
# ─────────────────────────────────────────────────────────────────────────────
# Component thresholds. These describe a corpus — how strict the quality gate
# is, how much tolerance amounts get — and a corpus does not change per
# invocation, so they are settings rather than flags. See `cli.md`.

# segmenter — confidence above which a cut is accepted. Below it the document
# is over-segmented, which is the recoverable direction. See components.md.
DOCFLOW_CUT_CONFIDENCE=0.7

# diagnosis — quality gate before routing. A text layer below this character
# count is not treated as a text layer, because the check is quality, not
# presence.
DOCFLOW_MIN_CHARS=100

# diagnosis — minimum DPI for the image route. Legibility is not resolution:
# an image can pass this and still be too blurred to read.
DOCFLOW_MIN_DPI=200

# reader — enable OCR-text correction. Correction exists only on the OCR path;
# a converter does not read badly. The `r` and `p` extractors must still
# tolerate whatever misreads the OCR produced.
DOCFLOW_CORRECT=false

# consistency — tolerance for amounts, in cents. Rounding between the two
# reads is legitimate; identifiers and dates are compared exactly.
DOCFLOW_TOLERANCE_AMOUNTS=1

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────
# Precedence, highest first:
#
#   1. CLI flag          --jobs 4
#   2. environment       DOCFLOW_JOBS=4
#   3. this file         DOCFLOW_JOBS=2
#   4. built-in default
#
# Not settable, on purpose. A default for any of these would change what a run
# does without anyone asking:
#
#   --force              would reprocess done work on every run
#   --stage              only meaningful alongside --force
#   --only               a persisted scope would narrow every later run
#
# Verification is not configurable either. Every `done` stage is checked
# against the filesystem whenever a ledger is read, because the run that most
# needs the check — the one after a forced kill — is the one least likely to
# ask for it.
