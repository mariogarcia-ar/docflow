# docflow — environment defaults
#
# Copy to `.env` and adjust. Values here are defaults for every invocation;
# a CLI flag always overrides the matching variable.
#
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real credentials.

# ─────────────────────────────────────────────────────────────────────────────
# Models — local extraction
# ─────────────────────────────────────────────────────────────────────────────
# Default for every pipeline that calls a model — EpVR and ErpVR, including
# M4-EpVR, whose extractor reads pixels directly. A per-invocation --model
# overrides it, so M4 can point at a vision model without changing this.
DOCFLOW_MODEL=ollama:qwen2.5

# ─────────────────────────────────────────────────────────────────────────────
# Models — frontier validator
# ─────────────────────────────────────────────────────────────────────────────
# The validator governs escalation and sets "could not" — see components.md.
# One of: claude | deepseek | openai | (another configured provider)
DOCFLOW_VALIDATOR=claude

# ─────────────────────────────────────────────────────────────────────────────
# Provider configuration
# ─────────────────────────────────────────────────────────────────────────────
# These have no CLI flag on purpose: a provider endpoint and a credential are
# environment facts, not per-invocation decisions. Putting them in `.env` keeps
# secrets out of shell history and process listings.

# Ollama endpoint. Unset uses the provider default.
# DOCFLOW_OLLAMA_HOST=http://127.0.0.1:11434

# Credentials for the validator above. Only its provider needs to be set.
# These are secrets — never in a committed file.
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Paths
# ─────────────────────────────────────────────────────────────────────────────
# Output directory. Results, ledgers and intermediates all live here, and a
# folder input mirrors its tree. See "Output directory" in use-case.md.
DOCFLOW_OUT=out

# Result format: json (default) | md | html
DOCFLOW_FORMAT=json

# Document-type schema handed to the validator.
# DOCFLOW_SCHEMA=schemas/factura.json

# Golden set, used for tuning the local models and for comparing pipelines on
# equal terms.
# DOCFLOW_GOLDEN=golden/facturas.jsonl

# ─────────────────────────────────────────────────────────────────────────────
# Execution
# ─────────────────────────────────────────────────────────────────────────────
# Concurrency for batch runs. Size to the machine, not to the corpus: the
# local model is usually the bottleneck, not the CPU.
DOCFLOW_JOBS=2

# Pipeline used when neither --pipeline nor --extractor is given.
# The thirteen codes are in workflow.md.
# DOCFLOW_PIPELINE=M1-ErpVR

# Extractor mode when the material is inferred per file: r | p | rp
# DOCFLOW_EXTRACTOR=rp

# ─────────────────────────────────────────────────────────────────────────────
# Component thresholds
# ─────────────────────────────────────────────────────────────────────────────
# Defaults for the component-level flags. These are the ones worth setting
# once for a corpus rather than passing on every invocation.

# segmenter — confidence above which a cut is accepted. Below it the document
# is over-segmented, which is the recoverable direction. See components.md.
DOCFLOW_CUT_CONFIDENCE=0.7

# diagnosis — quality gate before routing. A text layer below this character
# count is not treated as a text layer, because the check is quality, not
# presence.
DOCFLOW_MIN_CHARS=100

# diagnosis — minimum DPI for the image route. Legibility is not resolution:
# an image can pass this and still be too blurred to read.
DOCFLOW_MIN_DPI=200

# reader — enable OCR-text correction. Correction exists only on the OCR path;
# a converter does not read badly. The `r` and `p` extractors must still
# tolerate whatever misreads the OCR produced.
DOCFLOW_CORRECT=false

# reader — force a specific OCR engine. Unset uses the default.
# DOCFLOW_OCR=tesseract

# consistency — tolerance for amounts, in cents. Rounding between the two
# reads is legitimate; identifiers and dates are compared exactly.
DOCFLOW_TOLERANCE_AMOUNTS=1

# catalog — external source to validate identity fields against, e.g. a
# supplier registry. Unset means identity fields stay `unverified`.
# DOCFLOW_SOURCE=padron

# ─────────────────────────────────────────────────────────────────────────────
# Behaviour
# ─────────────────────────────────────────────────────────────────────────────
# Verify every `done` stage against the filesystem before trusting the ledger.
# Worth enabling when runs are interrupted by forced stops, at some cost per
# document. See "The ledger can be wrong" in use-case.md.
DOCFLOW_VERIFY=false

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────
# Precedence, highest first:
#
#   1. CLI flag          --jobs 4
#   2. environment       DOCFLOW_JOBS=4
#   3. this file         DOCFLOW_JOBS=8
#   4. built-in default
#
# Not settable here, on purpose — these are per-invocation decisions, and a
# default for them would be a footgun:
#
#   --force              reprocess what the ledger calls done
#   --stage              the stage a --force reprocess starts from
#   --isolate            keep downstream artifacts marked stale
#   --keep-artifacts     keep the previous artifact as .prev
#   --only               restrict a run to a subset
#   --dry-run            report what would happen, run nothing
