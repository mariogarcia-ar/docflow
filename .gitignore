# Environment — contains API keys for the frontier validator
.env
.env.local
.env.*.local

# docflow output and bookkeeping
out/
work/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Packaging (a src layout produces these next to src/)
src/*.egg-info/
src/*.egg-link

# Node, if the CLI is packaged that way
node_modules/
dist/
build/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# The source corpus. `documentos/` is input data, never committed: 11k files would
# make every clone unusable and the corpus is replaced between runs.
# TODO: [MVP] If the corpus ever needs to be versioned, use a manifest of hashes
# plus a fetch step, not the documents themselves.
/documentos/

